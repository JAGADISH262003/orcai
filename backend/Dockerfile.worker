# Standalone job worker — same image content as the API, different entrypoint.
# Runs `python -m app.worker` so background jobs can be scaled independently
# against the Postgres-backed queue (`FOR UPDATE SKIP LOCKED` claims).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml .
COPY app ./app
COPY alembic.ini .
COPY alembic ./alembic

RUN pip install --no-cache-dir .

CMD ["python", "-m", "app.worker"]