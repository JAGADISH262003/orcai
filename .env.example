# --- Environment -----------------------------------------------------
ENV=development               # development | staging | production
DEBUG=false

# --- Database --------------------------------------------------------
# SQLite (dev) or PostgreSQL.
DATABASE_URL=sqlite:///./orcai.db
# DATABASE_URL=postgresql+psycopg://orcai:orcai@localhost:5432/orcai

# --- Auth ------------------------------------------------------------
# MUST be a long random string in any real deployment.
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI providers ----------------------------------------------------
# auto | gemini | openai | none
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Inbound channels ------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# --- Rate limiting ---------------------------------------------------
RL_ENABLED=true
RL_REQUESTS_PER_MINUTE=180
RL_BURST=40

# --- Background jobs -------------------------------------------------
JOBS_POLL_SECONDS=2
JOBS_MAX_ATTEMPTS=3
JOBS_LEASE_SECONDS=300

# --- Uploads ---------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
UPLOAD_DIR=uploads