# ====================================================================
# ORCAI Platform — Environment Variables
# Copy this file to .env and fill in values for your deployment.
# ====================================================================

# --- Environment -----------------------------------------------------
ENV=development               # development | staging | production
DEBUG=false

# --- Database --------------------------------------------------------
# SQLite (dev) or PostgreSQL.
DATABASE_URL=sqlite:///./orcai.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/orcai

# --- Auth ------------------------------------------------------------
# MUST be a long random string (32+ chars) in any real deployment.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI providers ----------------------------------------------------
# Provider priority: gemini -> openai -> deterministic (fallback).
AI_PROVIDER=auto              # auto | gemini | openai | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60

# --- Inbound channels ------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# --- CORS / security -------------------------------------------------
# Comma-separated list of allowed origins (no trailing slash).
BACKEND_CORS_ORIGINS=http://localhost:3000
SECURITY_HEADERS=true
MAX_UPLOAD_BYTES=5242880

# --- Rate limiting ---------------------------------------------------
RL_ENABLED=true
RL_REQUESTS_PER_MINUTE=180    # per IP + authenticated user
RL_BURST=40

# --- Background jobs -------------------------------------------------
JOBS_ENABLED=true
JOBS_POLL_SECONDS=2
JOBS_MAX_ATTEMPTS=3
JOBS_LEASE_SECONDS=300

# --- Billing / uploads ----------------------------------------------
DEFAULT_AGENCY_TIER=starter
UPLOAD_DIR=uploads

# --- Email (SMTP) ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@orcai.ai
SMTP_TLS=true

# --- Scrapers -------------------------------------------------------
SCRAPE_USER_AGENT=ORCAI-RecruiterBot/1.0
SCRAPE_DELAY_SECONDS=2
SCRAPE_MAX_RESULTS=100
GOOGLE_API_KEY=
GOOGLE_CX_ID=                  # Custom Search Engine ID

# --- Enrichment (Tier 3) -------------------------------------------
APOLLO_API_KEY=
PDL_API_KEY=
HUNTER_API_KEY=

# --- Billing (Stripe / Razorpay) -----------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Candidate self-service portal ---------------------------------
PORTAL_SECRET_KEY=portal-dev-secret
PORTAL_TOKEN_EXPIRE_HOURS=72

# --- PostgreSQL (for docker-compose) --------------------------------
POSTGRES_PASSWORD=orcai_dev_password
